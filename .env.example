# Shared with Moodle mod_aiinterview plugin settings
SHARED_SECRET=dev-change-me-interview-secret

# Database (Railway Postgres injects DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Option 1: OpenAI (simplest quality) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=coral
OPENAI_TTS_MODEL=tts-1
# Keep true so student speech is transcribed for scoring/chat/coding handoff.
# false = cheaper but uses Whisper clips (less reliable).
OPENAI_REALTIME_TRANSCRIBE=true
OPENAI_REALTIME_POST_INSTRUCTIONS_TOKENS=4000
OPENAI_REALTIME_RETENTION_RATIO=0.8
VOICE_MODE=realtime

# --- Option 2: Self-hosted Ollama (see docs/SELF_HOST_OLLAMA.md) ---
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2:3b
# OPENAI_BASE_URL=https://YOUR-OLLAMA.up.railway.app/v1

# --- Option 3: OpenRouter / Groq / etc. (OpenAI-compatible) ---
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Gladia realtime STT (https://app.gladia.io → API key) ---
# GLADIA_API_KEY=your-gladia-key
# GLADIA_API_BASE=https://api.gladia.io
# STT_PROVIDER=auto

QA_TARGET_EXCHANGES=3
CORS_ORIGINS=*
